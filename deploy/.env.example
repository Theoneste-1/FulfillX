# Copy to /opt/fulfillx/.env on the server. Never commit the real file.

# GitHub Container Registry — must match the GitHub repo (lowercase)
IMAGE_REGISTRY=ghcr.io/<github-user>/fullfix
IMAGE_TAG=latest

# Postgres (used by every service DB)
POSTGRES_USER=fulfillx
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT HS256 secret — at least 32 bytes. Do not reuse the demo secret.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes

# Browser origin of the operations dashboard (CORS on the gateway)
APP_ORIGIN=https://app.example.com

# What the browser should call. Split domains: https://api.example.com
# Same host (nginx /api proxy): leave empty
PUBLIC_API_URL=https://api.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=https://grafana.example.com

# Demo auto-advances shipments to DELIVERED. Set false when you have a real carrier flow.
FULFILLX_DEMO=true
